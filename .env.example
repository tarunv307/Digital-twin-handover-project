# Backend Configuration (Local Dev & Render Production Reference)
DT_APP_NAME="PS-032 Industrial Digital Twin & Smart Shift Handover"
# Local SQLite default (Render injects DATABASE_URL for managed PostgreSQL)
DT_DATABASE_URL="sqlite:///./digital_twin.db"
# Render comma-separated frontend origins (e.g. https://ps032-digital-twin.onrender.com)
DT_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
DT_SECRET_KEY="replace-with-long-random-secret-in-production"
DT_SIMULATION_AUTOSTART="false"
DT_SIMULATION_INTERVAL_SEC="2.0"
DT_STALE_THRESHOLD_SEC="15"
DT_SERVE_FRONTEND="true"
DT_COOKIE_SAMESITE="lax"

# Frontend (Vite) — Leave unset when served from the same Render Web Service origin.
# If deploying frontend as a separate Render Static Site, set both to your Render Web Service HTTPS/WSS URLs:
# VITE_API_BASE_URL="https://ps032-digital-twin-api.onrender.com"
# VITE_WS_URL="wss://ps032-digital-twin-api.onrender.com/ws/digital-twin"
